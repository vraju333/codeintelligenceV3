APP_NAME=CodeIntelligencePython
APP_VERSION=1.0.0

# Recommended for hackathon/offline use:
DATABASE_MODE=postgres
#LOCAL_DATABASE_URL=sqlite:///./codeintelligence.db
POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codeintelligence
# Existing PostgreSQL remains supported.
# DATABASE_MODE=postgres
# POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/codeintelligence

# Optional transition mode:
# SQLite stays primary. Successful writes are also mirrored to PostgreSQL
# when PostgreSQL is reachable. PostgreSQL downtime does not break the app.
# DATABASE_MODE=dual
# LOCAL_DATABASE_URL=sqlite:///./codeintelligence.db
# POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/codeintell   igence

# Legacy compatibility: existing DATABASE_URL can still supply the PostgreSQL URL.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/codeintelligence

PYTHON_PROJECT_PATH=D:\AIlearning\organization-details
AUTO_PROJECT_INITIALIZATION=true

